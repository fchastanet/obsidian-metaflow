{
  "name": "metaflow",
  "version": "1.0.0",
  "description": "Automated metadata workflow management for Obsidian - sort properties, insert missing fields, and execute custom default value scripts with MetadataMenu and Templater integration",
  "main": "main.js",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "metadata",
    "frontmatter",
    "workflow",
    "automation",
    "metadatamenu",
    "templater"
  ],
  "author": "François Chastanet",
  "license": "MIT",
  "funding": {
    "type": "coffeescript",
    "url": "https://coff.ee/fchastanetl"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "debug": "node esbuild.config.mjs debug",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "npm run lint:eslint && npm run lint:typecheck",
    "lint:eslint": "eslint src --ext ts,tsx --max-warnings 0",
    "lint:typecheck": "tsc --noEmit -skipLibCheck",
    "lint:eslint:fix": "eslint src --ext ts,tsx --max-warnings 0 --fix",
    "sync": "node -e \"import('./scripts/sync.mjs').then(m => m.syncFiles())\"",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "build:win": "pkg . --targets node18-win-x64 --output dist/obsidian-metaflow-win.exe",
    "build:binary": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path dist/",
    "build:all": "npm run build && npm run build:binary"
  },
  "pkg": {
    "scripts": "lib/**/*.js",
    "assets": [
      "lib/**/*",
      "manifest.json",
      "versions.json"
    ],
    "outputPath": "dist/"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@types/reflect-metadata": "^0.0.5",
    "@typescript-eslint/eslint-plugin": "8.38.0",
    "@typescript-eslint/parser": "8.38.0",
    "builtin-modules": "5.0.0",
    "esbuild": "0.25.8",
    "eslint": "^8.57.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "obsidian": "latest",
    "ts-jest": "^29.4.0",
    "tslib": "2.8.1",
    "typescript": "^4.8"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "ace-builds": "^1.43.2",
    "acorn": "^8.15.0",
    "inversify": "^7.9.0",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.2.2"
  },
  "cspell": {
    "version": "0.2",
    "ignorePaths": [],
    "dictionaryDefinitions": [],
    "dictionaries": [],
    "words": [
      "Chastanet",
      "François",
      "frontmatter",
      "metadatamenu",
      "metaflow",
      "Templater"
    ],
    "ignoreWords": [],
    "import": []
  }
}

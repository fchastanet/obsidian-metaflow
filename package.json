{
  "name": "metaflow",
  "version": "1.0.0",
  "description": "Automated metadata workflow management for Obsidian - sort properties, insert missing fields, and execute custom default value scripts with MetadataMenu and Templater integration",
  "main": "main.js",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "metadata",
    "frontmatter",
    "workflow",
    "automation",
    "metadatamenu",
    "templater"
  ],
  "author": "François Chastanet",
  "license": "MIT",
  "funding": {
    "type": "coffeescript",
    "url": "https://coff.ee/fchastanetl"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "debug": "node esbuild.config.mjs debug",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "npm run lint:eslint && npm run lint:typecheck",
    "lint:eslint": "eslint src --ext ts,tsx --max-warnings 0",
    "lint:typecheck": "tsc --noEmit -skipLibCheck",
    "lint:eslint:fix": "eslint src --ext ts,tsx --max-warnings 0 --fix",
    "sync": "node -e \"import('./scripts/sync.mjs').then(m => m.syncFiles())\"",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "build:win": "pkg . --targets node18-win-x64 --output dist/obsidian-metaflow-win.exe",
    "build:binary": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path dist/",
    "build:all": "npm run build && npm run build:binary"
  },
  "pkg": {
    "scripts": "lib/**/*.js",
    "assets": [
      "lib/**/*",
      "manifest.json",
      "versions.json"
    ],
    "outputPath": "dist/"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/reflect-metadata": "^0.1.0",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.46.4",
    "builtin-modules": "5.0.0",
    "esbuild": "0.27.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^17.7.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "obsidian": "latest",
    "ts-jest": "^29.4.5",
    "tslib": "2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "dependencies": {
    "ace-builds": "^1.43.4",
    "acorn": "^8.15.0",
    "inversify": "^7.10.4",
    "lru-cache": "^11.2.2",
    "reflect-metadata": "^0.2.2"
  },
  "cspell": {
    "version": "0.2",
    "ignorePaths": [],
    "dictionaryDefinitions": [],
    "dictionaries": [],
    "words": [
      "Chastanet",
      "François",
      "frontmatter",
      "metadatamenu",
      "metaflow",
      "Templater"
    ],
    "ignoreWords": [],
    "import": []
  }
}
